# Flask
FLASK_ENV=development
JWT_SECRET_KEY=change-me

# Database
DATABASE_URL=sqlite:///bakery.db

# Admin user
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Poner en true una sola vez para rotar la clave del admin, y volver a false.
ADMIN_PASSWORD_RESET=false
ADMIN_NAME=Admin

# Mail
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@bakery.local
SUPPORT_EMAIL=support@bakery.local

# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
PAYMENT_CURRENCY=ars
BACKEND_PUBLIC_URL=

# Frontend
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Delivery
DELIVERY_ZONE_NAME=Villa Maipu
DELIVERY_FEE=2500
PICKUP_ADDRESS=Andres Bakery, Villa Maipu, General San Martin

# WhatsApp (ADR-002) - solo digitos con pais, sin + ni espacios
WHATSAPP_PHONE=

# Pagos (ADR-002): Mercado Pago apagado hasta tener credenciales
PAYMENTS_ENABLED=false

# Fotos subidas desde el panel (F45, ADR-018)
# UPLOAD_DIR vacio = <raiz del repo>/instance/uploads. Tope por archivo, en bytes.
UPLOAD_DIR=
UPLOAD_MAX_BYTES=4194304

# Asistente de recetas con IA (F46, ADR-020)
# Apagado por default. Sin ANTHROPIC_API_KEY no se prende ni con AI_ENABLED=true.
# Cuesta ~USD 0,02 por borrador: ver sdd/costs.md antes de prenderlo.
AI_ENABLED=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_DAILY_LIMIT=25
